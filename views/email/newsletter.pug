extends baseEmail

block content
  //- Renders each block from the drag-and-drop builder
  each block in blocks
    
    //- HEADING block
    if block.type === 'heading'
      h2(style='color: #800000; font-size: 24px; font-weight: bold; margin-bottom: 16px;')= block.content
    
    //- TEXT block
    if block.type === 'text'
      p(style='font-size: 14px; line-height: 1.6; color: #333333; margin-bottom: 15px;')= block.content
    
    //- IMAGE block
    if block.type === 'image'
      table(role='presentation', border='0', cellpadding='0', cellspacing='0', style='width:100%;')
        tbody
          tr
            td(style='text-align: center; padding-bottom: 15px;')
              img(
                src=block.url,
                alt=block.alt || 'Newsletter Image',
                style='max-width: 100%; height: auto; border-radius: 4px;'
              )
    
    //- BUTTON block
    if block.type === 'button'
      table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
        tbody
          tr
            td(align='left')
              table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                tbody
                  tr
                    td
                      a(href=block.url, target='_blank')= block.label || 'Click Here'
    
    //- DIVIDER block
    if block.type === 'divider'
      hr(style='border: 0; border-top: 1px solid #eeeeee; margin: 20px 0;')

  //- Unsubscribe footer
  p(style='font-size: 12px; color: #999999; margin-top: 20px;')
    | Don't want to receive these emails? 
    a(href=unsubscribeURL, style='color: #800000;') Unsubscribe here